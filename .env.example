# Copy to .env for local runs. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smartsplit
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/smartsplit_test
# Only needed for --live CLI runs and the opt-in live test (SMARTSPLIT_LIVE_LLM=1).
ANTHROPIC_API_KEY=
SMARTSPLIT_LLM_MODEL=claude-sonnet-5-5

# Shared secret the chat gateway sends as "Authorization: Bearer <token>". Required for the API:
# set a long random value (e.g. `openssl rand -hex 32`); empty means the API won't start.
SMARTSPLIT_API_TOKEN=
# Run the API on the offline stand-ins instead of the model (local trials only).
SMARTSPLIT_OFFLINE=0
SMARTSPLIT_CURRENCY=INR
SMARTSPLIT_DEFAULT_REGION=IN
SMARTSPLIT_TIMEZONE=Asia/Kolkata
SMARTSPLIT_LLM_TIMEOUT_SECONDS=60
SMARTSPLIT_LLM_MAX_TOKENS=16000
SMARTSPLIT_LLM_CALLS_PER_PERSON_PER_DAY=50
SMARTSPLIT_FUZZY_THRESHOLD=85
SMARTSPLIT_MIN_LINE_CONFIDENCE=0.6
SMARTSPLIT_MAX_RECEIPT_LINES=150
SMARTSPLIT_MAX_AMOUNT_CENTS=100000000
SMARTSPLIT_MAX_IMAGE_BYTES=5000000
SMARTSPLIT_MAX_QUEUED_DRAFTS=3
SMARTSPLIT_MAX_NOTIFICATIONS_PER_DAY=20
SMARTSPLIT_INVITE_TEMPLATE="I added our split on SmartSplit. Say hi to the bot to see it: https://wa.me/<bot-number>?text=hi"
SMARTSPLIT_IMAGE_DIR=./data/images
